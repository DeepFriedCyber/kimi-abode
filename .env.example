# === AI Service (Python/FastAPI) ===========================================
# PostgreSQL connection string — required for property search and auth
DATABASE_URL=postgresql://abode:change_me@localhost:5432/abode

# Database credentials (also used by docker-compose)
POSTGRES_USER=abode
POSTGRES_PASSWORD=change_me
POSTGRES_DB=abode

# Embedding provider — set to use OpenAI semantic cache / search
# Leave empty for hash-based fallback (no cost, no semantic meaning)
OPENAI_API_KEY=

# Chat LLM provider
ANTHROPIC_API_KEY=

# Protect write operations on POI ingestion endpoint
# Set a strong random string; omit or leave empty to disable
POI_INGEST_API_KEY=change_me_for_production

# === API Gateway (TypeScript/Fastify) ======================================
JWT_SECRET=change_me_to_a_random_string
AI_SERVICE_URL=http://localhost:8001
CORS_ORIGIN=http://localhost:3000
PORT=3001
