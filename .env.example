# =============================================================================
# Kimi Abode Environment Configuration
# =============================================================================
# This file contains example environment variables for the application.
# Copy this to .env and customize for your environment.
#
# Security: NEVER commit this file with real secrets!
# =============================================================================

# =============================================================================
# AI Service (Python/FastAPI) - Backend AI Model Service
# =============================================================================

# PostgreSQL connection string — required for property search and auth
# Format: postgres://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://abode:change_me_to_strong_password@localhost:5432/abode

# Database credentials (also used by docker-compose)
POSTGRES_USER=abode
POSTGRES_PASSWORD=change_me_to_strong_random_password
POSTGRES_DB=abode

# Embedding provider — use OpenAI or local Ollama (no API costs with Ollama)
# Priority: OPENAI_API_KEY > OLLAMA_URL > hash fallback
OPENAI_API_KEY=              # Leave empty to use Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Chat LLM provider (Anthropic for safety)
ANTHROPIC_API_KEY=           # Get from console.anthropic.com if using Claude

# Protect write operations on POI ingestion endpoint
# Set a strong random string; omit or leave empty to disable
POI_INGEST_API_KEY=change_me_to_strong_random_string

# =============================================================================
# API Gateway (TypeScript/Fastify) - Main API Server
# =============================================================================

# JWT_SECRET must be at least 32 characters for HS256 security
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=change_me_to_a_very_long_random_string_at_least_32_characters

# URL of the AI service (internal or external)
AI_SERVICE_URL=http://localhost:8001

# CORS origin(s) — comma-separated for multiple origins
# Development: http://localhost:3000
# Production: https://app.abode-ai.local,https://kimi-abode.local
CORS_ORIGIN=http://localhost:3000

# Server port
PORT=3001

# Node environment: development|production|test
NODE_ENV=development

# =============================================================================
# Security & Performance Tuning
# =============================================================================

# Database connection pool size (1-10 recommended)
DATABASE_POOL_SIZE=10

# Enable strict JWT verification in production
JWT_VERIFY_ENABLED=true

# Rate limiting configuration (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100