# =============================================================================
# Abode AI Service Environment Configuration
# =============================================================================
# This file contains example environment variables for the Python/FastAI service.
# Copy this to .env and customize for your environment.
#
# Security: NEVER commit this file with real secrets!
# =============================================================================

# =============================================================================
# PostgreSQL Connection - Database Configuration
# =============================================================================

# PostgreSQL connection string — required for property search and auth
# Format: postgres://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://abode:change_me_to_strong_password@localhost:5432/abode

# Embedding provider configuration
OPENAI_API_KEY=              # Leave empty to use Ollama (no API costs)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Chat LLM Configuration
# =============================================================================

# Anthropic Claude for chat responses (preferred for safety)
ANTHROPIC_API_KEY=           # Get from console.anthropic.com if using

# =============================================================================
# Database Connection Pool Settings - Prevent Exhaustion
# =============================================================================

AI_DB_POOL_MIN=2             # Minimum pool size (keeps connections warm)
AI_DB_POOL_MAX=10            # Maximum pool size (prevents exhaustion)
AI_DB_TIMEOUT=30             # Idle connection timeout in seconds

# =============================================================================
# CORS Configuration - API to Frontend Communication
# =============================================================================

AI_CORS_ORIGINS=http://localhost:3001  # Comma-separated list of allowed origins

# =============================================================================
# Application Settings
# =============================================================================

# Server host and port (for uvicorn if running directly)
HOST=0.0.0.0
PORT=8001

# Enable logging (debug for development, info for production)
LOG_LEVEL=info

# =============================================================================
# Security Best Practices
# =============================================================================

# 1. Use strong passwords in DATABASE_URL (at least 16 characters)
# 2. Generate secure random strings for API keys:
#    python -c "import os; print(os.urandom(32).hex())"
# 3. Never commit .env to version control
# 4. Use different secrets for development vs production

# Example of a secure DATABASE_URL with strong credentials:
# DATABASE_URL=postgresql://abode:xK9mP2nQ5wR7tY3uL6vB8nC0dF1gH@localhost:5432/abode?sslmode=disable

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================

# Enable connection health checks (recommended for production)
DB_HEALTH_CHECK_INTERVAL=60  # seconds between health checks

# Maximum query execution time before timeout (seconds)
QUERY_TIMEOUT=120

# Log slow queries (> this many ms)
SLOW_QUERY_THRESHOLD_MS=1000
